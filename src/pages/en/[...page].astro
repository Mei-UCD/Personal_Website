export const getStaticPaths = (async () => {
  const { perPage } = appConfig.posts

  const paths: Array<{
    params: { page?: string }
    props: {
      currentPage: number
      totalPage: number
      data: CollectionEntry<'posts'>[]
      locale: string
    }
    locale?: string
  }> = []

   const locale = 'en'


  const sortedPosts = await getSortedPosts(locale)

  const totalPage = Math.ceil(sortedPosts.length / perPage)

  for (let i = 0; i < totalPage; i++) {
    paths.push({
      params: {
        page: i === 0 ? undefined : `page/${i + 1}`,
      },
      props: {
        currentPage: i + 1,
        totalPage,
        data: sortedPosts.slice(i * perPage, (i + 1) * perPage),
        locale,
      },
      locale,
    })
  }

  return paths
}) satisfies GetStaticPaths


interface Props {
  currentPage: number
  totalPage: number
  data: CollectionEntry<'posts'>[]
}

const { currentPage, totalPage, data } = Astro.props

const hotTags = await getHotTags(5, lang)
const allTags = await getAllTags(lang)
const allCategories = await getAllCategories(lang)

const getPageUrl = (page: number) => {
  // if (page === 1) return '/en/'
  // return `/en/page/${page}`

  const path = page === 1 ? '/en/' : `/en/page/${page}`
  return getLocalizedPath(path, lang)
}
---

<PageLayout>
  <div>
    {currentPage === 1 && <Hero />}
    <div class="max-w-[1100px] px-4 md:px-8 py-20 mx-auto grid lg:grid-cols-[auto_300px] gap-10">
      <div class="min-w-0">
        <SectionBlock title={t.pages.latestPosts}>
          <PostList posts={data} />
          {
            totalPage > 1 && (
              <PostPagination current={currentPage} total={totalPage} getPageUrl={getPageUrl} />
            )
          }
        </SectionBlock>
      </div>
      <div>
        <aside class="md:sticky md:top-20 space-y-10">
          <SectionBlock title={t.pages.categories}>
            <CategoryList categories={allCategories} />
          </SectionBlock>
          <SectionBlock title={t.pages.hotTags}>
            <TagList tags={hotTags} />
            {
              allTags.length > hotTags.length && (
                <div class="mt-2 text-right">
                  <a class="text-sm text-secondary hover:text-accent" href={getLocalizedPath('/tags', lang)}>
                    {t.pages.moreTags} <i class="iconfont icon-arrow-right" />
                  </a>
                </div>
              )
            }
          </SectionBlock>
        </aside>
      </div>
    </div>
  </div>
</PageLayout>
