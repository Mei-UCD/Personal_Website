---
import Layout from '@/layouts/Layout.astro'
import { Flashlight } from '@/components/Flashlight'
import { getTranslations, getLangFromPath, defaultLang } from '@/utils/i18n'

const lang = getLangFromPath(Astro.url.pathname) ?? defaultLang
const t = getTranslations(lang)
const homeHref = lang === defaultLang ? '/' : `/${lang}/`
---

<Layout title={t.error.title}>
  <div class="max-w-[800px] mx-auto py-16 px-4 md:px-8">
    <h1 class="text-[4rem] md:text-[9rem] leading-tight font-bold">Not Found</h1>
    <p class="text-3xl mb-24 text-gray-800/90 dark:text-gray-200/90">
      {t.error.description}
    </p>
    <a class="text-accent text-xl md:text-2xl inline-flex" href={homeHref}
      ><i class="iconfont icon-arrow-left-up"></i>
      <span class="ml-2">{t.error.link}</span></a
    >
  </div>
  <Flashlight client:only="react" />
</Layout>