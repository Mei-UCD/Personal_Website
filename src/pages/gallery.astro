---
import Layout from '@/layouts/Layout.astro'
import { Header } from '@/components/header/Header'
import Footer from '@/components/footer/Footer.astro'
import { Provider } from '@/components/provider/Provider'
import Highlight from '@/components/Highlight.astro'
import { getLangFromPath, getTranslations, defaultLang } from '@/utils/i18n'
import GalleryGrid from '@/components/gallery/GalleryGrid.astro'
import LocationTimeline from '@/components/gallery/LocationTimeLine.astro'

import { GALLERIES } from '@/../scripts/gallery.config.js'

interface Props {
  title?: string
  description?: string
  image?: string
}

const lang = getLangFromPath(Astro.url.pathname) ?? defaultLang
const t = getTranslations(lang)
const title = t.gallery.title
const { description, image } = Astro.props
---




 <Layout title={title} description={description} image={image}>
  <Provider pathName={Astro.url.pathname} client:only="react" />
  <Header client:only="react" />

  <main class="relative pt-16 min-h-main bg-primary gallery-main">
    <div class="swup-transition-fade max-w-[1100px] mx-auto px-4 py-16">

      <!-- Page title -->
      <header class="space-y-4">
        <h1 class="text-4xl font-bold">
          <Highlight>{title}</Highlight>
        </h1>
      </header>

      <!-- Gallery layout -->
      <div class="gallery-layout  mt-16">

        <!-- Left: location timeline -->
        <aside class="gallery-nav">
          <LocationTimeline />
        </aside>

        <!-- Right: gallery content -->
        <section class="gallery-content">

          {Object.entries(GALLERIES).map(([folder, images]) => (
            <section id={folder.toLowerCase()} class="gallery-section">
              <GalleryGrid
                images={images}
                folder={folder}
                alt={`${folder} photography`}
              />
            </section>
          ))}

        </section>
      </div>

      <slot />
    </div>
  </main>

  <Footer />
</Layout>