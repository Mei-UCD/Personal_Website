---
import Layout from '@/layouts/Layout.astro'
import { Header } from '@/components/header/Header'
import Footer from '@/components/footer/Footer.astro'
import { Provider } from '@/components/provider/Provider'
import TravelMap from '@/components/gallery/TravelMap'
import travelData from '@/gallery.json'
import Highlight from '@/components/Highlight.astro'
import { getLangFromPath, getTranslations, defaultLang } from '@/utils/i18n'
import { kyotoImages } from '@/data/kyoto'
import { tokyoImages } from '@/data/tokyo'


const IMAGE_BASE = 'https://img.neuimay.com/blog/Kyoto'
const IMAGE_BASE_tokyo = 'https://img.neuimay.com/blog/Tokyo'

interface Props {
  title?: string
  description?: string
  image?: string
}

const lang = getLangFromPath(Astro.url.pathname) ?? defaultLang
const t = getTranslations(lang)
const title = t.gallery.title
const { description, image } = Astro.props
---

<Layout title={title} description={description} image={image}>
  <Provider pathName={Astro.url.pathname} client:only="react" />

  <Header client:only="react" />
  <main class="relative z-1 pt-16 min-h-main bg-primary">
    <div class="swup-transition-fade max-w-[800px] mx-auto px-4 py-16 space-y-8">
      <header class="space-y-4">
        <h1 class="text-4xl font-bold">
          <Highlight>{title}</Highlight>
        </h1>
      </header>

      <section class="mt-16">
        <!-- <h2 class="text-2xl font-semibold mb-6">
          Kyoto
        </h2> -->
      
        <div class="masonry">
          {kyotoImages.map((img) => (
            <div class="masonry-item">
              <img
                src={`${IMAGE_BASE}/${img}`}
                alt="Kyoto photography"
                loading="lazy"
                decoding="async"
                class="lazy-img"
              />
            </div>
          ))}
        </div>


        <div class="masonry">
          {tokyoImages.map((img) => (
            <div class="masonry-item">
              <img
                src={`${IMAGE_BASE_tokyo}/${img}`}
                alt="Tokyo photography"
                loading="lazy"
                decoding="async"
                class="lazy-img"
              />
            </div>
          ))}
        </div>


        
      </section>

      <slot />
    </div>
  </main>
  <Footer />
</Layout>






<script>
  document.addEventListener('DOMContentLoaded', () => {
    const images = document.querySelectorAll<HTMLImageElement>('.lazy-img');

    images.forEach((img) => {
      if (img.complete) {
        img.classList.add('loaded');
      } else {
        img.addEventListener('load', () => {
          img.classList.add('loaded');
        });
      }
    });
  });
</script>

