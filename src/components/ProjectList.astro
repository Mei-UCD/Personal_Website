---
import { getCollection } from 'astro:content'
import { getLangFromPath, defaultLang, getLocalizedPath, getPostSlug } from '@/utils/i18n'

const lang = (getLangFromPath(Astro.url.pathname) ?? defaultLang)

const allProjects = await getCollection('projects')

const projects = allProjects.filter((p) => {
  if (lang === 'en') {
    return p.slug.startsWith('en/')
  }
  // zh
  return !p.slug.includes('/')
})

const categories = {
  'Architecture': projects.filter((p) => p.data.category?.includes('Architecture')),
  'Full Stack': projects.filter((p) => p.data.category?.includes('FullStack')),
  'Data Science & ML': projects.filter((p) => p.data.category?.includes('DataScience') || p.data.category?.includes('ML')),
  'Image Processing': projects.filter((p) => p.data.category?.includes('ImageProcessing')),
}
---

