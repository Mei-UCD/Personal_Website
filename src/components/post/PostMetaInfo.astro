---
import { RelativeDate } from './RelativeDate'
import { getLangFromPath, getTranslations, defaultLang } from '@/utils/i18n'


interface Props {
  date: Date
  lastMod?: Date
  words: number
  readingMinutes: number
  class?: string
}

const { date, lastMod, words, readingMinutes, class: className } = Astro.props
const lang = getLangFromPath(Astro.url.pathname) ?? defaultLang
const t = getTranslations(lang)
---

<div class="flex flex-wrap gap-2 text-sm text-secondary" class:list={[className]}>
  <div>
    <i class="iconfont icon-calendar"></i>
    <RelativeDate date={date} client:idle />
    {lastMod && <span class="text-xs">({t.post.edited})</span>}
  </div>
  <div>
    <i class="iconfont icon-file-list"></i>
    <span>{words} {t.post.words}</span>
  </div>
  <div>
    <i class="iconfont icon-timer"></i>
    <span>{Math.ceil(readingMinutes)} {t.post.minutes}</span>
  </div>
</div>
