---
import { slugify } from '@/utils/content'
import { getLangFromPath, getLocalizedPath, defaultLang } from '@/utils/i18n'

interface Props {
  tags: string[]
  category?: string
  class?: string
}

const { tags, category, class: className } = Astro.props

const lang = getLangFromPath(Astro.url.pathname) ?? defaultLang
---

<div class="flex flex-wrap gap-2 text-sm text-secondary" class:list={[className]}>
  {
    category && (
      <div>
        <i class="iconfont icon-folder" />
        <a
          class="hover:text-accent hover:underline underline-offset-2 decoration-dashed"
          href={getLocalizedPath(`/categories/${slugify(category)}`, lang)}
        >
          {category}
        </a>
      </div>
    )
  }
  {
    tags.length > 0 && (
      <div>
        <i class="iconfont icon-hashtag" />
        {tags.map((tag, index) => (
          <>
            {index > 0 && <span>, </span>}
            <a
              class="hover:text-accent hover:underline underline-offset-2 decoration-dashed"
              href={getLocalizedPath(`/tags/${slugify(tag)}`, lang)}
            >
              {tag}
            </a>
          </>
        ))}
      </div>
    )
  }
</div>
