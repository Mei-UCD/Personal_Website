---
import blurMap from '@/generated/blurMap.json'

const typedBlurMap = blurMap as Record<string, string>
const IMAGE_BASE = 'https://img.neuimay.com/blog/gallery-grid'

interface Props {
  folder: string
  images: string[]
  alt?: string
}

const {
  folder,
  images,
  alt = '',
} = Astro.props
---


<div class="masonry">
  {images.map((img) => {
    const blur = typedBlurMap[`${folder}/${img}`]

    return (
      <div class="masonry-item">
        <div class="img-wrapper">

          {/* <img
            src={blur}
            alt=""
            aria-hidden="true"
            class="img-placeholder"
          />

          <img
            data-src={`${IMAGE_BASE}/${folder}/${img}?w=800&q=75`}
            alt={alt}
            loading="lazy"
            decoding="async"
            class="img-real"
          /> */}

          <img
            src={blur}
            data-src={`${IMAGE_BASE}/${folder}/${img}`}
            alt={alt}
            loading="lazy"
            decoding="async"
            class="img"
          />


        </div>
      </div>
    )
  })}
</div>




<!-- <script>
  // 视口懒加载：滚到哪里加载哪里
  const realImages = document.querySelectorAll('.img-real')

  const observer = new IntersectionObserver(
