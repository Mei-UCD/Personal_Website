<script>
  document.querySelectorAll<HTMLImageElement>('.img').forEach(img => {
    const real = img.dataset.src
    if (!real) return

    const tmp = new Image()
    tmp.src = real
    tmp.onload = () => {
      img.src = real
      img.classList.add('loaded')
    }
  })
</script>



  
  
<style>
  .masonry {
    column-count: 3;
    column-gap: 0.2rem;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 0.2rem;
    overflow: hidden;
  }

  .masonry img {
    width: 100%;
    border-radius: 0;
    display: block;
    transform: scale(1);
    transition: transform 0.3s ease;
  }

  .masonry-item:hover img {
    transform: scale(1.05);
  }


  /* 2026-01-17 */
  .img-wrapper {
    position: relative;
    overflow: hidden;
  }

  .img-placeholder {
    filter: blur(20px);
    transform: scale(1.15); 
  }

  .img-real {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .img-real.loaded {
    opacity: 1;
  }

  .img {
  width: 100%;
  display: block;
  filter: blur(20px);
  transform: scale(1.05);
  transition: filter 0.4s ease, transform 0.4s ease;
}

.img.loaded {
  filter: blur(0);
  transform: scale(1);
}


</style>