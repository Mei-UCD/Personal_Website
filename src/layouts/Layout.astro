---
import {
  CommonHead,
  WebAnalytics,
  ThemeLoader,
  AccentColorInjector,
  PrintVersion,
} from '@/components/head'
import { BackToTopFAB } from '@/components/BackToTopFAB'
import { ToastContainer } from '@/components/ToastContainer'
import { ModalStack } from '@/components/ui/modal'
import '@/styles/global.css'
import { getLangFromPath, defaultLang } from '@/utils/i18n'

interface Props {
  title?: string
  description?: string
  image?: string
}

const { title, description, image } = Astro.props
//const currentLang = Astro.locale || defaultLang
const currentLang = getLangFromPath(Astro.url.pathname) ?? defaultLang
const htmlLang = currentLang === 'en' ? 'en' : 'zh-CN'
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <CommonHead title={title} description={description} image={image} />
    <WebAnalytics />
    <ThemeLoader />
    <AccentColorInjector />
    <PrintVersion />
  </head>
  <body>
    <slot />

    <BackToTopFAB client:only="react" />
    <ToastContainer client:only="react" />
    <ModalStack client:only="react" />
  </body>
</html>
